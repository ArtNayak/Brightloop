generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// DRAFT -> QUOTATION -> CONFIRMED -> ACTIVE -> CLOSED
enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

// DRAFT -> CONFIRMED -> PAID (CANCELLED from DRAFT/CONFIRMED)
enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
}

// ---------- Users (owner: auth) ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  resetToken   String?  @unique // store a hash of the token, not the token
  resetExpires DateTime?
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
}

// ---------- Catalog (owner: products/plans) ----------

model Tax {
  id          String  @id @default(cuid())
  name        String
  ratePercent Decimal @db.Decimal(5, 2)
  active      Boolean @default(true)

  products Product[]
  lines    SubscriptionLine[]
}

model Product {
  id         String  @id @default(cuid())
  name       String
  type       String // e.g. "Software", "Add-on"
  salesPrice Decimal @db.Decimal(12, 2)
  costPrice  Decimal @db.Decimal(12, 2)
  notes      String?
  active     Boolean @default(true)
  taxId      String?
  tax        Tax?    @relation(fields: [taxId], references: [id])

  variants      ProductVariant[]
  subLines      SubscriptionLine[]
  templateLines QuotationTemplateLine[]
  discounts     Discount[]
}

// e.g. attribute "Brand", value "Odoo", extraPrice 560
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  subLines      SubscriptionLine[]
  templateLines QuotationTemplateLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id          String        @id @default(cuid())
  name        String
  price       Decimal       @db.Decimal(12, 2)
  period      BillingPeriod
  minQuantity Int           @default(1)
  startDate   DateTime // available from
  endDate     DateTime? // available until
  autoClose   Boolean       @default(false) // closes itself when it ends
  closable    Boolean       @default(true) // can be closed early
  pausable    Boolean       @default(false)
  renewable   Boolean       @default(true)

  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

// ---------- Quotes & subscriptions (owner: subscriptions) ----------

model QuotationTemplate {
  id           String @id @default(cuid())
  name         String
  validityDays Int    @default(30)
  planId       String
  plan         Plan   @relation(fields: [planId], references: [id])

  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  quantity   Int               @default(1)
}

model Subscription {
  id              String             @id @default(cuid())
  number          String             @unique // e.g. SUB-0001
  customerId      String
  customer        User               @relation(fields: [customerId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  templateId      String?
  template        QuotationTemplate? @relation(fields: [templateId], references: [id])
  status          SubscriptionStatus @default(DRAFT)
  paused          Boolean            @default(false)
  startDate       DateTime
  expiryDate      DateTime?
  paymentTerms    String? // e.g. "Net 15"
  quoteValidUntil DateTime?
  nextBillingDate DateTime? // billing run picks ACTIVE subs where this <= now
  createdAt       DateTime           @default(now())

  lines     SubscriptionLine[]
  invoices  Invoice[]
  discounts Discount[]

  @@index([status, nextBillingDate])
  @@index([customerId])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
}

// ---------- Discounts (owner: invoices/discounts) ----------

// scope PRODUCT      -> productId set, applies to that product's lines
// scope SUBSCRIPTION -> subscriptionId set = that subscription; null = every subscription
// Applies while now in [startDate, endDate] and timesUsed < usageLimit.
model Discount {
  id             String        @id @default(cuid())
  name           String
  type           DiscountType
  value          Decimal       @db.Decimal(12, 2)
  minPurchase    Decimal?      @db.Decimal(12, 2)
  minQuantity    Int?
  startDate      DateTime
  endDate        DateTime?
  usageLimit     Int?
  timesUsed      Int           @default(0)
  scope          DiscountScope
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

// ---------- Invoices & payments (owner: invoices / payments) ----------

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique // e.g. INV-0001
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  lines    InvoiceLine[]
  payments Payment[]

  // "nothing billed twice": the billing run relies on this constraint
  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxPercent     Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2) // after discount, before tax
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime
  note         String?
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}
