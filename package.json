{
  "name": "brightloop",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:billing": "tsx scripts/check-billing.ts",
    "check:billing-run": "tsx scripts/check-billing-run.ts",
    "check:route-guards": "tsx scripts/check-route-guards.ts",
    "check:billing-seed": "tsx scripts/check-billing-seed.ts",
    "check:invoice-view": "tsx scripts/check-invoice-view.ts",
    "check:invoices": "tsx scripts/check-invoices.ts",
    "check:invoice-http": "tsx scripts/check-invoice-http.ts",
    "check:catalog-seed": "tsx scripts/check-catalog-seed.ts",
    "check:taxes": "tsx scripts/check-taxes.ts",
    "check:products": "tsx scripts/check-products.ts",
    "check:plans": "tsx scripts/check-plans.ts",
    "check:discounts": "tsx scripts/check-discounts.ts",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "verify:deployment": "tsx --env-file=.env.production.local scripts/verify-deployment.ts",
    "check:period": "tsx scripts/check-period.ts",
    "test:subscriptions": "tsx --env-file=.env src/lib/subscription-state.check.ts",
    "test:subscription-input": "tsx --env-file=.env src/lib/subscriptions.check.ts",
    "test:quotation-templates": "tsx --env-file=.env src/lib/quotation-templates.check.ts",
    "test:customers": "tsx --env-file=.env src/lib/customers.check.ts",
    "test:lifecycle": "tsx --env-file=.env src/lib/subscription-lifecycle.check.ts",
    "check:lifecycle-http": "tsx --env-file=.env scripts/check-lifecycle-http.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed-bulk": "tsx prisma/seed-bulk.ts",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "test": "tsx src/lib/finance.check.ts && npm run test:auth",
    "test:auth": "tsx --env-file=.env src/app/api/auth/password-reset.check.ts",
    "test:staff": "tsx --env-file=.env src/app/api/staff/staff.check.ts",
    "test:payments": "tsx --env-file=.env src/app/api/payments/payments.check.ts",
    "test:payments-page": "tsx --env-file=.env \"src/app/(app)/payments/payments-page.check.ts\"",
    "test:portal": "tsx --env-file=.env \"src/app/(app)/portal/portal.check.ts\"",
    "test:audit": "tsx --env-file=.env src/lib/security-audit.check.ts",
    "test:reports": "tsx --env-file=.env \"src/app/(app)/reports/reports.check.ts\"",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
